// GENERATED by `pnpm rules:generate-frozen` from firebase/firestore.rules: do not edit.
// Deployed during the D1 cutover write freeze (`pnpm rules:freeze`); every write is denied.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLegacyAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }

    function isHePhaiAdmin() {
      return isLegacyAdmin() || role() == 'he_phai_admin';
    }

    function isHePhaiSecretary() {
      return role() == 'he_phai_secretary';
    }

    function isHePhaiScope() {
      return isHePhaiAdmin() || isHePhaiSecretary();
    }

    function isGiaoDoanAdmin() {
      return role() == 'giao_doan_admin';
    }

    function isKiemSoat() {
      return role() == 'kiem_soat';
    }

    function isStaff() {
      return isHePhaiScope() || isGiaoDoanAdmin() || isKiemSoat() || isLegacyAdmin();
    }

    function canWriteDirectory() {
      return isHePhaiScope() || isGiaoDoanAdmin() || isLegacyAdmin();
    }

    function isValidAuditCreate() {
      return request.resource.data.keys().hasAll(['action', 'at', 'actorType', 'actorId', 'changes'])
        && request.resource.data.action in ['created','updated','locked','unlocked','edit_requested','photo_uploaded','photo_deleted','document_uploaded','document_deleted']
        && request.resource.data.at is string
        && request.resource.data.actorType in ['admin', 'filler']
        && request.resource.data.actorId is string
        && request.resource.data.actorId.size() > 0
        && request.resource.data.changes is list;
    }

    function retreatOrgOk(orgUnitId) {
      return isHePhaiScope() || isLegacyAdmin()
        || (isGiaoDoanAdmin() && request.auth.token.orgUnitId == orgUnitId);
    }

    function directoryOrgOk(orgUnitId) {
      return isHePhaiScope() || isLegacyAdmin()
        || (isGiaoDoanAdmin() && request.auth.token.orgUnitId == orgUnitId);
    }

    function canListDirectory() {
      return isHePhaiScope() || isGiaoDoanAdmin();
    }

    // --- orgUnits: public read, he_phai write only ---
    match /orgUnits/{id} {
      allow get, list: if true;
      allow write: if false;
    }

    // --- invites: there is exactly one invite for the whole app (fixed doc
    // id "public", see PUBLIC_INVITE_ID) — it just gates the public
    // registration form; it does not scope org unit or record type (the
    // visitor picks those themselves). The bearer credential is knowing the
    // id/token for a single get(); listing (enumeration) stays admin-only. ---
    match /invites/{id} {
      allow get: if true;
      allow list: if canWriteDirectory();
      allow create: if false;
      allow update, delete: if false;
    }

    // --- members: doc id is deterministic ({orgUnitId}_{sanghaType}_{cccd}),
    // mirroring the invites/{token} pattern. Knowing a member's CCCD (plus
    // the small, effectively-public set of orgUnitId/sanghaType values) is
    // the same bearer-secret model already used for invite tokens and for
    // "resume by CCCD" today — this just makes it possible to enforce with
    // rules by collapsing the old two-hop (memberCccdIndex -> members)
    // lookup into a single deterministic id. ---
    match /members/{memberId} {
      function coreIdentityUnchanged() {
        return request.resource.data.orgUnitId == resource.data.orgUnitId
          && request.resource.data.sanghaType == resource.data.sanghaType
          && request.resource.data.cccd == resource.data.cccd
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function lockFieldsUnchanged() {
        return request.resource.data.status == resource.data.status
          && request.resource.data.lockedAt == resource.data.lockedAt
          && request.resource.data.lockedBy == resource.data.lockedBy;
      }

      // tinhTrang is an admin-only field (quick-edited from the members list);
      // fillers may neither set it on create nor change it on save-and-lock.
      function tinhTrangUnchanged() {
        return request.resource.data.get('tinhTrang', null)
          == resource.data.get('tinhTrang', null);
      }

      function tinhTrangAbsent() {
        return !('tinhTrang' in request.resource.data);
      }

      function editRequestFieldsUnchanged() {
        return request.resource.data.editRequestedAt == resource.data.editRequestedAt
          && request.resource.data.editRequestedBy == resource.data.editRequestedBy;
      }

      function isLockTransition() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lockedAt', 'lockedBy', 'editRequestedAt', 'editRequestedBy', 'updatedAt']);
      }

      function isFillerSaveAndLock() {
        return resource.data.status == 'draft'
          && request.resource.data.status == 'locked'
          && request.resource.data.lockedBy == 'filler'
          && request.resource.data.lockedAt is string
          && request.resource.data.editRequestedAt == null
          && request.resource.data.editRequestedBy == null
          && tinhTrangUnchanged();
      }

      function isFillerEditRequest() {
        return resource.data.status == 'locked'
          && request.resource.data.status == 'locked'
          && lockFieldsUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['editRequestedAt', 'editRequestedBy', 'updatedAt']);
      }

      function isFillerMediaUpdate() {
        return lockFieldsUnchanged()
          && editRequestFieldsUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoPath', 'documents', 'updatedAt'])
          && (
            // Unlocked (draft): clear / replace / attach photo and documents.
            (resource.data.status == 'draft'
              && request.resource.data.status == 'draft')
            // Locked: first portrait attach only — cannot clear or replace.
            || (resource.data.status == 'locked'
              && (request.resource.data.photoPath == resource.data.photoPath
                || resource.data.photoPath == null))
          );
      }

      // Admin-created drafts have inviteId == null. A filler may complete one
      // (save-and-lock), which stamps the current invite on it; otherwise the
      // invite a record was written under stays fixed.
      function inviteKeptOrAdopted() {
        return request.resource.data.inviteId == resource.data.inviteId
          || (resource.data.inviteId == null && isFillerSaveAndLock());
      }

      function isFillerLockedUpdate() {
        return isFillerSaveAndLock() || isFillerEditRequest() || isFillerMediaUpdate();
      }

      function isAdminCreateShape() {
        return request.resource.data.status == 'draft'
          && request.resource.data.lockedAt == null
          && request.resource.data.lockedBy == null;
      }

      function isFillerCreateShape() {
        return request.resource.data.status == 'locked'
          && request.resource.data.lockedBy == 'filler'
          && request.resource.data.lockedAt is string
          && request.resource.data.editRequestedAt == null
          && request.resource.data.editRequestedBy == null
          && tinhTrangAbsent();
      }

      function directoryRoleFieldsUnchanged() {
        return request.resource.data.get('directoryRole', null) == resource.data.get('directoryRole', null)
          && request.resource.data.get('directoryAuthUid', null) == resource.data.get('directoryAuthUid', null)
          && request.resource.data.get('directoryRoleGrantedAt', null) == resource.data.get('directoryRoleGrantedAt', null)
          && request.resource.data.get('directoryRoleGrantedBy', null) == resource.data.get('directoryRoleGrantedBy', null);
      }

      function secretaryEmailUnchanged() {
        return resource.data.get('directoryRole', null) == null
          || request.resource.data.get('email', null) == resource.data.get('email', null);
      }

      // Re-validated (not frozen) on every non-admin write: the caller must
      // currently hold a valid invite. With a single global invite this is
      // just an existence check — org unit / sangha type are the visitor's
      // own choice, not something the invite scopes.
      function validInviteScope(data) {
        return data.inviteId is string
          && exists(/databases/$(database)/documents/invites/$(data.inviteId));
      }

      allow get: if true;
      allow list: if canWriteDirectory() && (
        isHePhaiScope() || directoryOrgOk(resource.data.orgUnitId)
      );

      allow create: if false;

      allow update: if false;

      allow delete: if false;

      match /auditLogs/{logId} {
        allow read: if canWriteDirectory();
        // getAfter: parent may be created in the same transaction as this log
        // (filler save-and-lock create). Plain get() only sees committed docs.
        allow create: if false;
        allow update, delete: if false;
      }
    }

    // --- temples: ids stay random (a phone can map to several temples, so
    // it can't collapse to one deterministic id the way members can). The
    // bearer credential is "a currently valid invite" — re-checked on every
    // non-admin write, same pattern as members. ---
    match /temples/{templeId} {
      function createdAtUnchanged() {
        return request.resource.data.createdAt == resource.data.createdAt;
      }

      function orgUnitUnchanged() {
        return request.resource.data.orgUnitId == resource.data.orgUnitId;
      }

      function orgUnitReassignOk() {
        return isHePhaiAdmin()
          && resource.data.status == 'draft'
          && request.resource.data.status == 'draft'
          && request.resource.data.orgUnitId is string
          && directoryOrgOk(resource.data.orgUnitId)
          && directoryOrgOk(request.resource.data.orgUnitId);
      }

      function identityOk() {
        return createdAtUnchanged()
          && (orgUnitUnchanged() || orgUnitReassignOk());
      }

      function lockFieldsUnchanged() {
        return request.resource.data.status == resource.data.status
          && request.resource.data.lockedAt == resource.data.lockedAt
          && request.resource.data.lockedBy == resource.data.lockedBy;
      }

      function editRequestFieldsUnchanged() {
        return request.resource.data.editRequestedAt == resource.data.editRequestedAt
          && request.resource.data.editRequestedBy == resource.data.editRequestedBy;
      }

      function isLockTransition() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lockedAt', 'lockedBy', 'editRequestedAt', 'editRequestedBy', 'updatedAt']);
      }

      function isFillerSaveAndLock() {
        return resource.data.status == 'draft'
          && request.resource.data.status == 'locked'
          && request.resource.data.lockedBy == 'filler'
          && request.resource.data.lockedAt is string
          && request.resource.data.editRequestedAt == null
          && request.resource.data.editRequestedBy == null;
      }

      function isFillerEditRequest() {
        return resource.data.status == 'locked'
          && request.resource.data.status == 'locked'
          && lockFieldsUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['editRequestedAt', 'editRequestedBy', 'updatedAt']);
      }

      function isFillerTempleMediaUpdate() {
        return lockFieldsUnchanged()
          && editRequestFieldsUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoPath', 'updatedAt'])
          && (
            // Unlocked (draft): clear / replace / attach photo.
            (resource.data.status == 'draft'
              && request.resource.data.status == 'draft')
            // Locked: first portrait attach only — cannot clear or replace.
            || (resource.data.status == 'locked'
              && (request.resource.data.photoPath == resource.data.photoPath
                || resource.data.photoPath == null))
          );
      }

      // Admin-created drafts have inviteId == null. A filler may complete one
      // (save-and-lock), which stamps the current invite on it; otherwise the
      // invite a record was written under stays fixed.
      function inviteKeptOrAdopted() {
        return request.resource.data.inviteId == resource.data.inviteId
          || (resource.data.inviteId == null && isFillerSaveAndLock());
      }

      function isFillerLockedUpdate() {
        return isFillerSaveAndLock() || isFillerEditRequest() || isFillerTempleMediaUpdate();
      }

      function isAdminCreateShape() {
        return request.resource.data.status == 'draft'
          && request.resource.data.lockedAt == null
          && request.resource.data.lockedBy == null;
      }

      function isFillerCreateShape() {
        return request.resource.data.status == 'locked'
          && request.resource.data.lockedBy == 'filler'
          && request.resource.data.lockedAt is string
          && request.resource.data.editRequestedAt == null
          && request.resource.data.editRequestedBy == null;
      }

      function validInviteScope(data) {
        return data.inviteId is string
          && exists(/databases/$(database)/documents/invites/$(data.inviteId));
      }

      allow get: if true;
      allow list: if canWriteDirectory() && (
        isHePhaiScope() || directoryOrgOk(resource.data.orgUnitId)
      );

      allow create: if false;

      allow update: if false;

      allow delete: if false;

      match /auditLogs/{logId} {
        allow read: if canWriteDirectory();
        // getAfter: parent may be created in the same transaction as this log
        // (filler save-and-lock create). Plain get() only sees committed docs.
        allow create: if false;
        allow update, delete: if false;
      }
    }

    // --- templeManagerPhoneIndex: secondary lookup index, {orgUnitId}_{phone}
    // -> {templeIds: [...]}, so resumeTemplesByPhone can find candidate ids
    // with a get() instead of an open list() query on temples. This is
    // defense-in-depth only, not the primary gate: the temples/{id} rules
    // above are what actually authorize reading/editing each record, so a
    // malformed index entry can at worst point at a temple id the caller
    // could already get() directly (get is public), not leak anything new. ---
    match /templeManagerPhoneIndex/{indexId} {
      allow get: if true;
      allow list: if canWriteDirectory();
      allow create, update: if false;
      allow delete: if false;
    }

    match /memberPhoneIndex/{indexId} {
      allow get: if true;
      allow list: if canWriteDirectory();
      allow create, update: if false;
      allow delete: if false;
    }

    match /retreats/{id} {
      function retreatStatusUnchanged() {
        return request.resource.data.status == resource.data.status;
      }

      function isRetreatStatusTransition() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      }

      function validRetreatStatusTransition() {
        return (resource.data.status == 'draft' && request.resource.data.status == 'open')
          || (resource.data.status == 'closed' && request.resource.data.status == 'open')
          || (resource.data.status == 'open' && request.resource.data.status == 'closed');
      }

      allow get: if true;
      allow list: if canWriteDirectory() && (
        isHePhaiScope() || retreatOrgOk(resource.data.orgUnitId)
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /retreatRegistrations/{id} {
      function registrationIdOk(data) {
        return id == (data.retreatId + '_' + data.memberId);
      }

      function registrationCreateShape(data) {
        return data.status == 'pending'
          && data.approvedBy == null
          && data.approvedAt == null
          && data.rejectionReason == null
          && registrationIdOk(data);
      }

      function registrationReviewKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approvedBy', 'approvedAt', 'rejectionReason', 'updatedAt']);
      }

      function registrationImmutableOk() {
        return request.resource.data.retreatId == resource.data.retreatId
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.orgUnitId == resource.data.orgUnitId
          && request.resource.data.registeredVia == resource.data.registeredVia
          && request.resource.data.registeredBy == resource.data.registeredBy
          && request.resource.data.extraAnswers == resource.data.extraAnswers
          && request.resource.data.createdAt == resource.data.createdAt
          && registrationIdOk(request.resource.data);
      }

      function validRegistrationReview() {
        return resource.data.status == 'pending'
          && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedAt is string
          && request.resource.data.updatedAt is string
          && (
            (request.resource.data.status == 'approved' && request.resource.data.rejectionReason == null)
            || (request.resource.data.status == 'rejected'
                && (request.resource.data.rejectionReason == null
                    || (request.resource.data.rejectionReason is string
                        && request.resource.data.rejectionReason.size() > 0)))
          );
      }

      // Public get-by-id (same bearer model as members): needed so the
      // client can duplicate-check before create. List stays staff-scoped.
      allow get: if true;
      allow list: if canWriteDirectory()
        && retreatOrgOk(resource.data.orgUnitId);

      // Self: any caller (incl. signed-in staff testing /r) may create with
      // registeredVia self. Proxy: directory writers only, scoped by org.
      allow create: if false;

      allow update: if false;
      allow delete: if false;
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hephai-khatsi",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "member-photos",
      "preview_bucket_name": "member-photos-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hephai-khatsi",
      "database_id": "2cd8ee1d-a474-412c-aa19-f7088d4374a1",
      // hephai-khatsi-preview: import dry runs (pnpm db:migrate:preview).
      "preview_database_id": "998c50bd-5c8e-41bc-9fe0-a255ba1c45d2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "R2_ACCOUNT_ID": "f263bbfd7be32d7002a58899a8dbd30b",
    "R2_BUCKET_NAME": "member-photos",
    "FIREBASE_PROJECT_ID": "hephaikhatsi-82658",
    // firestore | d1: the cutover switch (see src/worker/env.ts).
    "DATA_BACKEND": "d1"
  }
}

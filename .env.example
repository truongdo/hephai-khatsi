# Firebase web SDK (Vite — browser Auth only; the data lives in D1)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hephaikhatsi-82658
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=hephaikhatsi-82658.appspot.com
# true only for a build deployed during a maintenance window: shows a
# maintenance banner on every page
VITE_MAINTENANCE_MODE=
# Public base URL for member portrait objects in R2 (no trailing slash)
# e.g. https://pub-xxxx.r2.dev or https://photos.example.com
VITE_PHOTOS_PUBLIC_BASE=
# Sentry — browser error reporting (DSN is public; leave empty to disable)
VITE_SENTRY_DSN=
# Sentry — source map upload at build time (never prefix these with VITE_)
SENTRY_ORG=he-phai-khat-si
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

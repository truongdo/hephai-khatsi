# Client SDK (Vite — browser Auth/Firestore/Storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hephaikhatsi-82658
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=hephaikhatsi-82658.appspot.com
# Data backend of the client repositories: firestore (default) or d1 (the
# Worker's /api/data routes; the Worker var DATA_BACKEND must match)
VITE_DATA_BACKEND=firestore
# Public base URL for member portrait objects in R2 (no trailing slash)
# e.g. https://pub-xxxx.r2.dev or https://photos.example.com
VITE_PHOTOS_PUBLIC_BASE=
# Sentry — browser error reporting (DSN is public; leave empty to disable)
VITE_SENTRY_DSN=
# Sentry — source map upload at build time (never prefix these with VITE_)
SENTRY_ORG=he-phai-khat-si
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Firestore export of the D1 migration (pnpm export:firestore): a service
# account with Firestore read access, either as the raw JSON string (same as
# the Worker secret) or as a path to its JSON file (git-ignored, never commit)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
